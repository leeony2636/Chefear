# Copy to .env locally; never commit the real values.
# Hugging Face private model repository ID (optional if using the built-in default).
HF_STT_MODEL_REPO=
# CTranslate2 private repository or local cache path for faster-whisper deployment.
HF_STT_CT2_REPO=
STT_LOCAL_CACHE_DIR=
# Hugging Face access token. Keep the value only in the local environment.
HF_TOKEN=
